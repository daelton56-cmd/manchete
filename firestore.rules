rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function turmaDoc(t) { return get(/databases/$(database)/documents/turmas/$(t)); }
    function isMember(t) { return signedIn() && exists(/databases/$(database)/documents/turmas/$(t)/membros/$(me())); }
    function memberOf(t, u) { return exists(/databases/$(database)/documents/turmas/$(t)/membros/$(u)); }
    function isAdmin(t) { return isMember(t) && me() in turmaDoc(t).data.admins; }
    function isOwner(t) { return signedIn() && turmaDoc(t).data.ownerUid == me(); }
    function same(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function fpath(a, b) { return /databases/$(database)/documents/friendships/$(a + '_' + b); }
    function areFriends(a, b) {
      return (exists(fpath(a, b)) && get(fpath(a, b)).data.status == 'accepted')
        || (exists(fpath(b, a)) && get(fpath(b, a)).data.status == 'accepted');
    }
    function playerDoc(t, p) { return get(/databases/$(database)/documents/turmas/$(t)/players/$(p)); }
    function guestOwner(t, p) { return exists(/databases/$(database)/documents/turmas/$(t)/players/$(p)) && playerDoc(t, p).data.guest == true && (playerDoc(t, p).data.createdBy == me() || isAdmin(t)); }
    function gameDoc(t, g) { return get(/databases/$(database)/documents/turmas/$(t)/games/$(g)); }
    function canJoin(d) {
      return d.get('vis', 'turma') == 'turma' || me() in d.get('allowed', [])
        || (d.get('vis', 'turma') == 'amigos' && areFriends(me(), d.createdBy));
    }
    function canSeeGame(t, d) { return canJoin(d) || d.createdBy == me() || isAdmin(t); }
    function inTeams(d) {
      let ts = d.get('teams', null);
      return ts != null && ((ts.size() > 0 && me() in ts[0]) || (ts.size() > 1 && me() in ts[1]) || (ts.size() > 2 && me() in ts[2]) || (ts.size() > 3 && me() in ts[3]));
    }
    function resultSame() {
      return request.resource.data.get('sets', []) == resource.data.get('sets', [])
        && request.resource.data.get('teams', null) == resource.data.get('teams', null)
        && request.resource.data.get('join', {}) == resource.data.get('join', {})
        && request.resource.data.get('leave', {}) == resource.data.get('leave', {})
        && request.resource.data.get('track', []) == resource.data.get('track', [])
        && request.resource.data.get('log', []).size() == resource.data.get('log', []).size();
    }
    function privacyOn(t) { return turmaDoc(t).data.get('privacyV', 1) >= 2; }
    function noPersonal() { return !request.resource.data.keys().hasAny(['name', 'nick', 'photo', 'height', 'birthYear']); }

    match /users/{u} {
      allow read, write: if signedIn() && me() == u;
      // Lista de amigos de cada um (nome e foto pequena), para sugestões de "amigo de fulano".
      match /amigos/{f} {
        allow read: if signedIn() && (me() == u || areFriends(me(), u));
        allow create, update: if signedIn() && (me() == u || me() == f) && areFriends(u, f);
        allow delete: if signedIn() && (me() == u || me() == f);
      }
    }

    // Vitrine para a busca: só nome, apelido, foto pequena e o e-mail embaralhado. Qualquer conta lê; só o dono grava.
    match /perfisPublicos/{u} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == u
        && (request.resource == null || request.resource.data.keys().hasOnly(['name', 'nick', 'photo', 'keys', 'emailHash', 'updated']));
    }

    // Amistosos: partidas sem turma ou de várias turmas. Não mexem em carta.
    // Quem pode ver fica guardado na própria partida (visibleTo), montado por quem marcou.
    match /partidas/{p} {
      allow read: if signedIn() && (me() in resource.data.visibleTo || resource.data.createdBy == me());
      allow create: if signedIn() && request.resource.data.createdBy == me() && me() in request.resource.data.visibleTo
        && request.resource.data.get('votes', {}).size() == 0;
      allow update: if signedIn() && same('createdBy') && (
        (resource.data.createdBy == me() && same('votes') && same('conf') && same('roster'))
        || (changed().hasOnly(['conf', 'roster']) && me() in resource.data.visibleTo
            && request.resource.data.get('conf', []).removeAll([me()]) == resource.data.get('conf', []).removeAll([me()])
            && request.resource.data.get('roster', {}).diff(resource.data.get('roster', {})).affectedKeys().hasOnly([me()]))
        || (changed().hasOnly(['votes']) && inTeams(resource.data)
            && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([me()])
            && (!(me() in request.resource.data.get('votes', {})) || (request.resource.data.votes[me()] is string && request.resource.data.votes[me()] != me()))));
      allow delete: if signedIn() && resource.data.createdBy == me();
    }

    // Amizades: valem para o app inteiro.
    // Jogos abertos: a vitrine pública de um jogo de turma com vagas abertas.
    // 'todos' = qualquer conta lê; 'rede' = só quem está na lista. Quem organiza grava tudo;
    // quem é da turma só atualiza a contagem de confirmados.
    match /abertos/{g} {
      allow read: if signedIn() && (resource.data.vis == 'todos' || me() in resource.data.get('rede', []) || resource.data.createdBy == me());
      allow create: if signedIn() && request.resource.data.createdBy == me() && isMember(request.resource.data.turma);
      allow update: if signedIn() && same('createdBy') && same('turma') && (
        resource.data.createdBy == me()
        || (isMember(resource.data.turma) && changed().hasOnly(['conf', 'updated'])));
      allow delete: if signedIn() && (resource.data.createdBy == me() || isAdmin(resource.data.turma));

      // Pedido de vaga: só quem pediu e quem organiza leem.
      match /pedidos/{u} {
        allow read: if signedIn() && (me() == u || get(/databases/$(database)/documents/abertos/$(g)).data.createdBy == me()
          || isAdmin(get(/databases/$(database)/documents/abertos/$(g)).data.turma));
        allow create: if signedIn() && me() == u && request.resource.data.status == 'pendente';
        allow update: if signedIn() && (
          (me() == u && changed().hasOnly(['status', 'at']) && request.resource.data.status in ['pendente', 'cancelado'])
          || get(/databases/$(database)/documents/abertos/$(g)).data.createdBy == me()
          || isAdmin(get(/databases/$(database)/documents/abertos/$(g)).data.turma));
        allow delete: if signedIn() && (me() == u || get(/databases/$(database)/documents/abertos/$(g)).data.createdBy == me());
      }
    }

    // Denúncias: qualquer conta envia; ninguém lê pelo app (só no console do Firebase).
    match /denuncias/{d} {
      allow create: if signedIn() && request.resource.data.by == me();
    }

    match /friendships/{f} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create: if signedIn() && me() in request.resource.data.users && request.resource.data.users.size() == 2
        && request.resource.data.users[0] != request.resource.data.users[1]
        && f == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && (
          (request.resource.data.status == 'pending' && request.resource.data.from == me())
          || (memberOf(request.resource.data.turma, request.resource.data.users[0])
              && memberOf(request.resource.data.turma, request.resource.data.users[1]) && (
          (request.resource.data.status == 'accepted' && request.resource.data.via == 'convite' && (
                (request.resource.data.users[0] == me() && request.resource.data.k == get(/databases/$(database)/documents/turmas/$(request.resource.data.turma)/convites/$(request.resource.data.users[1])).data.token)
                || (request.resource.data.users[1] == me() && request.resource.data.k == get(/databases/$(database)/documents/turmas/$(request.resource.data.turma)/convites/$(request.resource.data.users[0])).data.token)))
          || (request.resource.data.status == 'accepted' && request.resource.data.via == 'turma'
              && request.resource.data.k == turmaDoc(request.resource.data.turma).data.inviteCode
              && turmaDoc(request.resource.data.turma).data.ownerUid in request.resource.data.users)
          || (request.resource.data.status == 'accepted' && request.resource.data.via == 'migracao'
              && turmaDoc(request.resource.data.turma).data.ownerUid == me())))
          || (request.resource.data.status == 'accepted' && request.resource.data.via == 'link'
              && request.resource.data.k is string && request.resource.data.k.size() >= 8 && (
                (request.resource.data.users[0] == me() && request.resource.data.k == get(/databases/$(database)/documents/users/$(request.resource.data.users[1])).data.get('friendCode', ''))
                || (request.resource.data.users[1] == me() && request.resource.data.k == get(/databases/$(database)/documents/users/$(request.resource.data.users[0])).data.get('friendCode', ''))))
        );
      allow update: if signedIn() && me() in resource.data.users && resource.data.status == 'pending' && resource.data.from != me()
        && request.resource.data.status == 'accepted' && changed().hasOnly(['status', 'acceptedAt']);
      allow delete: if signedIn() && me() in resource.data.users;
    }

    match /turmas/{t} {
      allow read: if isMember(t);
      allow create: if signedIn() && request.resource.data.ownerUid == me() && request.resource.data.admins == [me()];
      allow update: if isAdmin(t) && same('ownerUid') && resource.data.ownerUid in request.resource.data.admins;
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /membros/{m} {
        allow read: if isMember(t);
        allow create: if signedIn() && m == me() && request.resource.data.uid == me() && (
          request.resource.data.code == getAfter(/databases/$(database)/documents/turmas/$(t)).data.inviteCode
          || (request.resource.data.get('by', '') != '' && memberOf(t, request.resource.data.by)
              && request.resource.data.code == get(/databases/$(database)/documents/turmas/$(t)/convites/$(request.resource.data.by)).data.token));
        allow update: if isOwner(t) && changed().hasOnly(['name']) && !('name' in request.resource.data);
        allow delete: if signedIn() && (m == me() || (isAdmin(t) && m != turmaDoc(t).data.ownerUid));
      }

      // Link pessoal de convite de cada membro.
      match /convites/{u} {
        allow read, write: if isMember(t) && me() == u;
        allow delete: if isOwner(t);
      }

      // Nome, apelido, foto, altura e idade: só quem está na turma.
      match /profiles/{p} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && (p == me() || guestOwner(t, p) || isOwner(t));
        allow delete: if isMember(t) && (p == me() || guestOwner(t, p) || isOwner(t));
      }

      // Cópia de segurança feita antes da mudança de privacidade: só quem criou a turma.
      match /backups/{b} {
        allow read, write: if isOwner(t);
      }

      match /players/{p} {
        allow read: if isMember(t);
        allow create: if isMember(t) && request.resource.data.createdBy == me() && request.resource.data.get('locked', false) == false
          && (!privacyOn(t) || noPersonal()) && (
          (p == me() && request.resource.data.ownerUid == me() && request.resource.data.guest == false)
          || (p.matches('g_.*') && request.resource.data.ownerUid == null && request.resource.data.guest == true));
        allow update: if isMember(t) && same('ownerUid') && same('guest') && same('createdBy') && (!privacyOn(t) || noPersonal()) && (
          (p == me() && !changed().hasAny(['adj']) && (resource.data.get('locked', false) == false || (same('base') && same('locked'))))
          || (resource.data.guest == true && (resource.data.createdBy == me() || isAdmin(t)))
          || (changed().hasOnly(['locked']) && request.resource.data.locked == true)
          || (isOwner(t) && noPersonal() && changed().hasOnly(['name', 'nick', 'photo', 'height', 'birthYear'])));
        allow delete: if isMember(t) && ((resource.data.guest == true && (resource.data.createdBy == me() || isAdmin(t))) || turmaDoc(t).data.ownerUid == me());
      }

      match /photos/{p} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && (p == me() || guestOwner(t, p));
        allow delete: if isMember(t) && (p == me() || guestOwner(t, p) || turmaDoc(t).data.ownerUid == me());
      }

      match /games/{g} {
        allow read: if isMember(t);
        allow create: if isMember(t) && request.resource.data.get('confirms', {}).size() == 0 && request.resource.data.get('votes', {}).size() == 0
          && request.resource.data.get('rates', {}).size() == 0 && (
          request.resource.data.createdBy == me()
          // Jogo semanal: qualquer membro cria a próxima semana, no nome de quem marcou a série.
          || (request.resource.data.get('prev', '') != ''
              && exists(/databases/$(database)/documents/turmas/$(t)/games/$(request.resource.data.prev))
              && gameDoc(t, request.resource.data.prev).data.get('repeat', false) == true
              && gameDoc(t, request.resource.data.prev).data.createdBy == request.resource.data.createdBy
              && gameDoc(t, request.resource.data.prev).data.get('serie', '') == request.resource.data.get('serie', '')
              && gameDoc(t, request.resource.data.prev).data.get('vis', 'turma') == request.resource.data.get('vis', 'turma')
              && gameDoc(t, request.resource.data.prev).data.get('allowed', []) == request.resource.data.get('allowed', [])
              && request.resource.data.get('seq', 0) == gameDoc(t, request.resource.data.prev).data.get('seq', 0) + 1
              && g == request.resource.data.serie + '-' + string(request.resource.data.seq)
              && request.resource.data.get('conf', []).size() == 0
              && request.resource.data.get('sets', []).size() == 0));
        allow update: if isMember(t) && same('createdBy') && (
          ((resource.data.createdBy == me() || isAdmin(t)) && same('confirms') && same('votes') && same('rates')
            && (resultSame() || request.resource.data.get('resultRev', 0) > resource.data.get('resultRev', 0)))
          || (changed().hasOnly(['conf']) && canJoin(resource.data)
              && request.resource.data.get('conf', []).removeAll([me()]) == resource.data.get('conf', []).removeAll([me()]))
          || (changed().hasOnly(['votes']) && inTeams(resource.data)
              && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([me()])
              && (!(me() in request.resource.data.get('votes', {})) || (request.resource.data.votes[me()] is string && request.resource.data.votes[me()] != me())))
          || (changed().hasOnly(['rates']) && inTeams(resource.data)
              && request.resource.data.get('rates', {}).diff(resource.data.get('rates', {})).affectedKeys().hasOnly([me()])
              && (!(me() in request.resource.data.get('rates', {}))
                  || (request.resource.data.rates[me()] is map && request.resource.data.rates[me()].size() <= 40 && !(me() in request.resource.data.rates[me()]))))
          || (changed().hasOnly(['confirms'])
              && request.resource.data.get('confirms', {}).diff(resource.data.get('confirms', {})).affectedKeys().hasOnly([me()])
              && (!(me() in request.resource.data.get('confirms', {})) || request.resource.data.confirms[me()] == resource.data.get('resultRev', 0))));
        allow delete: if isMember(t) && (resource.data.createdBy == me() || isAdmin(t));

        // Nome de quem está na partida, visível só para quem pode ver a partida.
        match /roster/{p} {
          allow read: if isMember(t) && canSeeGame(t, gameDoc(t, g).data);
          allow write: if isMember(t) && (p == me() || gameDoc(t, g).data.createdBy == me() || isAdmin(t));
        }
      }
    }
  }
}
